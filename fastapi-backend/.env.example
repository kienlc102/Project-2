# FastAPI Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Project
PROJECT_NAME="FastAPI Template"
API_V1_STR="/api/v1"

# Database Connection
# === Option 1: PostgreSQL local (default) ===
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/project-2

# === Option 2: NeonDB (cloud - comment in nếu dùng NeonDB, comment out dòng trên) ===
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# AI API Keys (for AI-generated flashcards & quiz)
# Keys này hiện được dùng bởi backend/ai-service/ (Node.js)
# Điền vào backend/ai-service/.env
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# AI Microservice URL
AI_SERVICE_URL=http://localhost:5004/api/generate
