# Environment Variables for fastapi-service
# Copy this file to .env and fill in the values

# === Local PostgreSQL (default for dev) ===
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/project-2

# === NeonDB (comment in if using NeonDB, comment out the local line above) ===
# DATABASE_URL=postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require&channel_binding=require

# Gemini API key (for AI features)
GEMINI_API_KEY=

# Groq API key (for AI features)
GROQ_API_KEY=
